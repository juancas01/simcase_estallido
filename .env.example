# Copie este archivo a `.env` en la raíz y rellene la llave.
#
# Solo hace falta para las DOS capas de lenguaje natural: el canal de órdenes
# (capa 4) y la esfera pública (capa 3). El motor corre entero sin ninguna de
# ellas, y sin llave las dos degradan a contenido determinista y lo dicen en
# `generado_por`. Comprobar el montaje en `/api/config`.

OPENAI_API_KEY=

# --- El modelo -------------------------------------------------------------
MODELO_NLU=gpt-5-nano
MODELO_ENTORNO=gpt-5-nano

# --- El presupuesto de latencia, que es DURO -------------------------------
# Si el proveedor tarda más, se degrada a contenido determinista en vez de
# dejar a ocho personas mirando la pantalla.
TIMEOUT_NLU=12
TIMEOUT_ENTORNO=20

# Reintentos del SDK. **Cero, y a propósito.** El valor de fábrica es 2, así que
# un presupuesto de 12 s se convertía en tres intentos y hasta 36 s de reloj:
# el presupuesto declarado no era el que se esperaba. Con 0, lo es.
REINTENTOS_LLM=0

# Esfuerzo de razonamiento (familia gpt-5). Medido, no supuesto: con el valor de
# fábrica la esfera pública tardaba 26–36 s y NUNCA entraba en su presupuesto
# —salía de plantilla en todos los turnos—, y el canal tenía la cola pegada al
# suyo. Con `low`, la capa 4 baja de 8,0 s a 2,4 s de mediana y la capa 3 a 6 s,
# sin perder ni uno de los nueve casos difíciles.
#
# `minimal` NO sirve para el canal: con él, «declaren el estado de sitio» llama
# a firmar la asistencia militar. Vacío = no se manda el parámetro, que es lo
# que hay que poner si se apunta a un modelo que no razona o a otro proveedor.
ESFUERZO_NLU=low
ESFUERZO_ENTORNO=low

# --- Opcionales ------------------------------------------------------------
# Otro proveedor compatible con la API de OpenAI.
# OPENAI_BASE_URL=

# Trazas.
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=simcase-estallido
